Notebook[{

Cell[CellGroupData[{
Cell["Copy Drees formula", "Subsection",
 CellChangeTimes->{{3.877578045430937*^9, 
  3.877578050044053*^9}},ExpressionUUID->"bcaaeb42-0f3d-4a14-a21f-\
19d1aa048870"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"FF", "[", "x_", "]"}], ":=", 
  RowBox[{
   FractionBox["30", 
    RowBox[{"7", 
     SuperscriptBox["Pi", "4"]}]], 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"4", 
          SuperscriptBox["y", "2"]}], "-", 
         SuperscriptBox["x", "2"]}], ")"}], 
       SqrtBox[
        RowBox[{
         SuperscriptBox["y", "2"], "-", 
         SuperscriptBox["x", "2"]}]]}], 
      RowBox[{
       RowBox[{"Exp", "[", "y", "]"}], "+", "1"}]], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", "x", ",", "Infinity"}], "}"}]}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FB", "[", "x_", "]"}], ":=", 
  RowBox[{
   FractionBox["30", 
    RowBox[{"7", 
     SuperscriptBox["Pi", "4"]}]], 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"4", 
          SuperscriptBox["y", "2"]}], "-", 
         SuperscriptBox["x", "2"]}], ")"}], 
       SqrtBox[
        RowBox[{
         SuperscriptBox["y", "2"], "-", 
         SuperscriptBox["x", "2"]}]]}], 
      RowBox[{
       RowBox[{"Exp", "[", "y", "]"}], "-", "1"}]], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", "x", ",", "Infinity"}], "}"}]}], "]"}]}]}]}], "Input",\

 CellChangeTimes->{{3.8775773253810663`*^9, 3.877577401412038*^9}, {
  3.877577799148346*^9, 3.877577807699822*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"843ab5f3-24de-46e0-a1be-994208ca32c7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Nnu", "=", "3"}], ";", 
  RowBox[{"TnuD", "=", "2.3"}], ";"}]], "Input",
 CellChangeTimes->{{3.877577370315933*^9, 3.8775773780196342`*^9}, {
  3.877578013559598*^9, 3.877578015044729*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"cede1d2e-abf7-4c18-be24-d1f16b45e28b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Reproduce Drees results", "Subsection",
 CellChangeTimes->{{3.8775780289678793`*^9, 
  3.877578037863536*^9}},ExpressionUUID->"09f891d4-1476-4f44-ad3f-\
99937683d1bf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"LogLinearPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"3", ",", 
     RowBox[{"Nnu", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{
          FractionBox["1", "Nnu"], 
          FractionBox["3", "2"], 
          RowBox[{"FB", "[", 
           FractionBox["mX", "TnuD"], "]"}]}]}], ")"}], 
       RowBox[{"4", "/", "3"}]]}], ",", " ", 
     RowBox[{"Nnu", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{
          FractionBox["1", "Nnu"], 
          FractionBox["3", "2"], 
          RowBox[{"FB", "[", 
           FractionBox["mX", "TnuD"], "]"}]}], "+", 
         RowBox[{
          FractionBox["1", "Nnu"], 
          FractionBox["4", "2"], 
          RowBox[{"FF", "[", 
           FractionBox[
            RowBox[{"0.31", " ", "mX"}], "TnuD"], "]"}]}]}], ")"}], 
       RowBox[{"4", "/", "3"}]]}], ",", 
     RowBox[{"Nnu", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{
          FractionBox["1", "Nnu"], 
          FractionBox["3", "2"], 
          RowBox[{"FB", "[", 
           FractionBox["mX", "TnuD"], "]"}]}], "+", 
         RowBox[{
          FractionBox["1", "Nnu"], 
          FractionBox["4", "2"], 
          RowBox[{"FF", "[", 
           FractionBox[
            RowBox[{"0.51", " ", "mX"}], "TnuD"], "]"}]}]}], ")"}], 
       RowBox[{"4", "/", "3"}]]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"mX", ",", "1", ",", "100"}], "}"}], ",", 
   RowBox[{"PlotLegends", "\[Rule]", "\"\<Expressions\>\""}], ",", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"2", ",", "9"}], "}"}]}]}], "]"}]], "Input",
